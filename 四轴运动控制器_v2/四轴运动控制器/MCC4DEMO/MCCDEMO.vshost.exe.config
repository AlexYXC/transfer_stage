<?xml version="1.0"?>
<configuration>
<startup>
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0,Profile=Client"/>
</startup>
<appSettings>
  <!-- Language的值只能是Chinese（中文），English（英文） -->
  <!-- add key="Language" value="English"/> -->
  <add key="Language" value="Chinese"/>
</appSettings>
</configuration>
